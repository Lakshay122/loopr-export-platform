{
  "name": "loopr-export-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Customer-configurable export platform (CSV workflow prototype)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/bin/migrate.ts",
    "dev:api": "tsx watch src/bin/api.ts",
    "dev:worker": "tsx watch src/bin/worker.ts",
    "dev:dispatcher": "tsx watch src/bin/dispatcher.ts",
    "dev:scheduler": "tsx watch src/bin/scheduler.ts",
    "cli": "tsx src/bin/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "bullmq": "^6.7.5",
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
